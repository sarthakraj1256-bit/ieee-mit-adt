{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ieee-mit-adt",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-09-10",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ieee-mit-adt-db",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID"
  }],
  "r2_buckets": [{
    "binding": "MEDIA",
    "bucket_name": "ieee-mit-adt-media"
  }]
}
